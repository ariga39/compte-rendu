{
  "name": "compte-rendu",
  "private": true,
  "scripts": {
    "check": "vp check && corepack pnpm --filter @compte-rendu/dashboard check",
    "test": "vp test && corepack pnpm test:runtime",
    "test:runtime": "vitest run --config tests/runtime/vitest.config.mjs",
    "test:dashboard": "corepack pnpm --filter @compte-rendu/dashboard test:dashboard",
    "render:wrangler": "node --experimental-strip-types scripts/render-wrangler-config.mts",
    "diagnose": "node --experimental-strip-types scripts/diagnose.mts",
    "build": "vp run --filter './apps/dashboard' --filter './apps/core' --filter './apps/ingress' --filter './apps/runner' --filter './apps/llm-service' --fail-if-no-match build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "effect": "4.0.0-rc.111",
    "playwright": "1.61.1",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
