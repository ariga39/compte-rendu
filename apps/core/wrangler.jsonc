{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compte-rendu-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "vars": {
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "RUNNER_AUTH_TOKEN"],
  },
  "d1_databases": [
    {
      "binding": "REVIEW_DB",
      "database_name": "compte-rendu-review-state",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "binding": "REVIEW_WORKFLOW",
      "name": "compte-rendu-review",
      "class_name": "ReviewWorkflow",
    },
  ],
  "vpc_services": [
    {
      "binding": "RUNNER",
      "service_id": "REPLACE_WITH_RUNNER_VPC_SERVICE_ID",
      "remote": true,
    },
  ],
}
