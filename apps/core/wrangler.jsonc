{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petit-chiba-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "vars": {
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "MODEL_API_KEY"],
  },
  "d1_databases": [
    {
      "binding": "REVIEW_DB",
      "database_name": "petit-chiba-review-state",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "binding": "REVIEW_WORKFLOW",
      "name": "petit-chiba-review",
      "class_name": "ReviewWorkflow",
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "REVIEW_LEASE", "class_name": "ReviewLeaseDurableObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "ReviewLeaseDurableObject"],
    },
  ],
}
