{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compte-rendu-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "vars": {
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
    "POSTHOG_ENABLED": "false",
    "POSTHOG_PROJECT_API_KEY": "",
    "POSTHOG_HOST": "",
    "POSTHOG_DEPLOYMENT": "",
    "POSTHOG_ENVIRONMENT": "production",
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "RUNNER_AUTH_TOKEN"],
  },
  "d1_databases": [
    {
      "binding": "REVIEW_DB",
      "database_name": "compte-rendu-review-state",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "compte-rendu-review-evidence",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "ReviewLeaseDurableObject"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["Sandbox", "ReviewLeaseDurableObject"],
    },
  ],
  "vpc_services": [
    {
      "binding": "RUNNER",
      "service_id": "REPLACE_WITH_RUNNER_VPC_SERVICE_ID",
      "remote": true,
    },
  ],
}
