{
  "name": "@compte-rendu/dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vp build",
    "dev": "vp dev",
    "preview": "vp preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "check:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test:dashboard": "playwright test"
  },
  "dependencies": {
    "@compte-rendu/contracts": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/svelte-query": "6.3.1",
    "carbon-components-svelte": "0.113.1",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "mdsvex": "0.12.8",
    "rehype-slug": "6.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
